# =============================================================================
# BACKEND API
# Expo exposes EXPO_PUBLIC_* variables to the app bundle. Do not put secrets here.
# Restart Metro after changing this value.
# =============================================================================
# USB-connected physical Android device (run: adb reverse tcp:4000 tcp:4000)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Android Emulator uses the host alias below:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# Physical Android/iOS devices must use the development computer's LAN address:
# Physical device over Wi-Fi (replace with this computer's current LAN IP)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4000/api/v1

# If the LAN IP keeps changing, skip this file and use the in-app Server
# Settings screen (login screen footer -> "Server settings", or Profile ->
# Server settings). The value entered there is persisted via AsyncStorage
# and wins over EXPO_PUBLIC_API_BASE_URL.
