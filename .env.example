# =============================================================================
# BACKEND API
# Expo exposes EXPO_PUBLIC_* variables to the app bundle. Do not put secrets here.
# Restart Metro after changing this value.
# =============================================================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Android Emulator uses the host alias below:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
# Physical Android/iOS devices must use the development computer's LAN address:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4000/api/v1
